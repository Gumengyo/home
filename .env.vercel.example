# Vercel 项目 Settings → Environment Variables
# 仅填写上游音源的服务端变量，不上传本机 .env.local 或 LINYU_ENV_FILE。
MUSIC_API_URL=https://your-source.example.com
MUSIC_API_KEY=replace-with-your-source-key
# 与 Linyu 相同的音质表；留空则沿用默认 320k。
# MUSIC_QUALITIES={"wy":["128k","320k"],"tx":["320k"],"kw":[],"kg":[],"mg":[]}

# Vercel 构建默认启用 linyu 模式，云端默认加载仓库的 music.playlist.json。
# 如需改用 Meting，显式设置 VITE_SONG_PROVIDER=meting 并重新部署。
