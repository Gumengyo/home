# 将所需设置复制到 .env.local；不修改原有 .env。
VITE_SONG_PROVIDER=linyu

# 方案一：仅从本机 linyu 的 .env 读取三个音源变量。
# 不读取账号、数据库、AI 配置，也不执行 linyu 代码。
LINYU_ENV_FILE=D:/code/front/linyu/.env

# 方案二：部署时直接提供与 linyu 相同的上游配置（无需 LINYU_ENV_FILE）。
# MUSIC_API_URL=https://your-source.example.com
# MUSIC_API_KEY=replace-with-your-source-key
# MUSIC_QUALITIES={"wy":["128k","320k"],"tx":["320k"],"kw":[],"kg":[],"mg":[]}

# 最多 200 首，ID 使用 linyu 同样的格式。
MUSIC_PLAYLIST_FILE=./music.example.json
# 默认优先 320k，不支持时取平台首个已开放档位；也可显式指定。
# MUSIC_QUALITY=320k
